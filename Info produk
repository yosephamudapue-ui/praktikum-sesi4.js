let produk= {
    name:"mouse wireless",
    harga_barang: 300000,
    stok_tersedia: 200,
    diskon: 0.35,
    infoProduk: function(){
        return(
            "Name:" + this.name+"\n"+
            "Harga barang:"+ this.harga_barang +"\n" +
            "Stok barang:" + this.stok_tersedia +"\n" +
            "Diskon barang:" + this.diskon 
        )
    },
Harga_Diskon : function(){
    let hasil= this.harga_barang - (this.harga_barang *this.diskon);
    return hasil;
},
    beli_produk: function(jumlah){
        if(this.stok_tersedia <= 0){
            console.log("maaf,stok sudah habis!");
