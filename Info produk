            console.log("stok tidak mencukupi! Hanya tersisa " (this.stok) +"item");
        } else {
            this.stok_tersedia = this.stok_tersedia - jumlah;
            console.log("Pembelian berhasil! Sisa stok: "+ this.stok_tersedia);
            if (this.stok_tersedia <=0){
                console.log("Stok produk kini habis, segara restock!");
            }
        }
    }
}
